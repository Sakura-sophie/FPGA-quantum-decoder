lam= 100
no_events=np.size(coordinates)
np.random.seed(42)
Poisson_1s = np.random.poisson(lam,no_events)

def add_gaussian(image, cx, cy, brightness, std=2):
    for y in range(image.shape[0]):
        for x in range(image.shape[1]):
            dist2 = (x-cx)**2 + (y-cy)**2
            image[y,x] += brightness * np.exp(-dist2 / (2*std**2))

for idx, (cx, cy) in enumerate(coordinates):
    total_photons = Poisson_1s[idx]
    background_gaussian[cx,cy] += total_photons
